# Copiez ce fichier en .env puis changez le mot de passe.
# Le fichier .env n'est jamais envoyé sur GitHub (voir .gitignore).

# Mot de passe du compte sa de SQL Server :
# 8 caractères minimum, avec majuscules, minuscules, chiffres et symboles.
MSSQL_SA_PASSWORD=ChangezMoi_2026!

# Connexion de l'API à la base
DB_USER=sa
DB_PORT=1433
# Base du projet, créée par le service db-init (épisode 7)
DB_NAME=MiniERP

# Épisode 10 · secret qui signe les jetons de connexion (32 caractères minimum).
# Générez le vôtre, ne réutilisez jamais celui d'un autre projet :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# L'API refuse de démarrer tant qu'il est vide ou trop court.
JWT_SECRET=
